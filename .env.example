# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# Get a key at https://aistudio.google.com/apikey
# (rotate the one you pasted in chat — treat it as already compromised)
GEMINI_API_KEY=AQ.Ab8RN6IWWgiQyZSOwu4CvIBOzThQ0So7ng3RDF3MCFzkJwLVyg
GEMINI_MODEL=gemini-flash-latest

# MySQL (optional — the API runs fine without these, it just skips persistence)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_energy_management

# Only needed if you tunnel the Colab-hosted Flask app with ngrok
NGROK_AUTHTOKEN=your-ngrok-authtoken-here
